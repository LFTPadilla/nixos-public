#!/usr/bin/env bash

# Nix flake rebuild helper:
# - macOS: darwin-rebuild
# - NixOS: nixos-rebuild switch
# - Other Linux (e.g. Ubuntu + Home Manager): home-manager switch (profile from DOTFILES_PROFILE, default ubuntu-dev)
#
# Optional: DOTFILES=/path/to/dotfiles  (defaults to $HOME/.dotfiles)
# Optional: DOTFILES_FORMAT=1 formats tracked Nix files before switching.

set -euo pipefail

REPO="${DOTFILES:-$HOME/.dotfiles}"
LOG_FILE="${TMPDIR:-/tmp}/dotfiles-switch.$(date +%Y%m%d-%H%M%S).log"

pushd "$REPO" >/dev/null

# Formatting changes tracked files. Keep it opt-in so a rebuild never creates
# unrelated diffs; use DOTFILES_FORMAT=1 when that is explicitly intended.
if [[ "${DOTFILES_FORMAT:-0}" == "1" ]]; then
  if command -v alejandra >/dev/null 2>&1; then
    alejandra .
  elif command -v nixpkgs-fmt >/dev/null 2>&1; then
    mapfile -t NIX_FILES < <(git ls-files '*.nix' || true)
    if ((${#NIX_FILES[@]})); then
      nixpkgs-fmt "${NIX_FILES[@]}"
    fi
  fi
fi

git --no-pager diff -U0 -- '*.nix' || true

if [[ "$(uname)" == "Darwin" ]]; then
  HOST="${1:-mac}"
  FLAKE="${REPO}#${HOST}"
  echo "Darwin: darwin-rebuild switch --flake ${FLAKE}"
  if ! sudo darwin-rebuild switch --flake "$FLAKE" -L 2>&1 | tee "$LOG_FILE"; then
    echo "Rebuild failed. Log: $LOG_FILE" >&2
    exit 1
  fi
elif [[ -f /etc/NIXOS ]]; then
  HOST="${1:-default}"
  FLAKE="${REPO}#${HOST}"
  echo "NixOS: nixos-rebuild switch --flake ${FLAKE}"
  if ! sudo nixos-rebuild switch --flake "$FLAKE" -L 2>&1 | tee "$LOG_FILE"; then
    echo "Rebuild failed. Log: $LOG_FILE" >&2
    exit 1
  fi
else
  PROFILE="${DOTFILES_PROFILE:-ubuntu-dev}"
  FLAKE="${REPO}#${PROFILE}"
  echo "Home Manager (${PROFILE}): nix run nixpkgs#home-manager -- switch --flake ${FLAKE}"
  if ! nix run nixpkgs#home-manager -- switch --flake "$FLAKE" -L 2>&1 | tee "$LOG_FILE"; then
    echo "Rebuild failed. Log: $LOG_FILE" >&2
    exit 1
  fi
fi

popd >/dev/null

echo "Done. Log: $LOG_FILE"
